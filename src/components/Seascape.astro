---
const swell = (i: number) => `M-18 ${179+i*3.8} C62 ${190+i*4} 142 ${101+i*2.1} 207 ${112+i*1.9} S309 ${217+i*2.8} 418 ${185+i*2.1} S562 ${122+i*2.8} 680 ${161+i*3.1}`;
---
<svg class="seascape" viewBox="0 0 660 250" aria-hidden="true" preserveAspectRatio="xMidYMax slice">
  <defs>
    <pattern id="moon-lines" width="5" height="5" patternUnits="userSpaceOnUse" patternTransform="rotate(-18)">
      <path d="M0 0h5" stroke="#715e46" opacity=".34" stroke-width="1"/>
    </pattern>
  </defs>
  <g class="moon">
    <circle cx="454" cy="91" r="60" fill="var(--moon)"/>
    <circle cx="454" cy="91" r="60" fill="url(#moon-lines)"/>
  </g>
  <g fill="none" stroke="var(--func)" opacity=".55">
    <path d="M347 96h73m-42 5h62m43-22h62m-26 4h38M97 83h86m-67 5h39"/>
    <path d="M289 48q8-3 12 2q4-7 12-8m7-9q5-2 9 1q2-4 8-5"/>
  </g>
  <g class="water">
    <path d="M-5 189Q75 152 151 174T326 168T535 160T665 151V250H-5Z" fill="var(--bg3)"/>
    <path d={swell(0)+' V280 H-18Z'} fill="var(--bg_m1)"/>
    {Array.from({length:36}, (_,i) => <path d={swell(i)} fill="none" stroke={i%7===0?'var(--keyword)':'var(--func)'} stroke-width={i%5===0?1.8:1} opacity={0.8-i*0.012}/>)}
  </g>
</svg>
