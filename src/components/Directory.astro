---
const { directory } = Astro.props;
---
  <section class="tools" id="tools" aria-labelledby="tools-title">
    <h2 id="tools-title">Find your tool</h2>
    <div class="tool-search" id="tool-search" hidden>
      <label class="sr-only" for="tool-query">Filter tools</label>
      <input type="search" id="tool-query" placeholder="Search tools…" autocomplete="off">
    </div>
    <p class="section-note" id="no-tools" role="status" hidden>No matching tools. Try a different name.</p>
    <div id="tool-directory">
      <Fragment set:html={directory} />
    </div>
  </section>
