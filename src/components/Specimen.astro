---
interface Props {
  scene: 'editor' | 'agent' | 'terminal';
}

type Run = string | [role: string, text: string];
interface Sample {
  file: string;
  language: string;
  lines: Run[][];
  cursorLine?: number;
}

const { scene } = Astro.props;
const samples: Sample[] = [
  { file: 'tides.ts', language: 'TypeScript', cursorLine: 7, lines: [
    [['keyword', 'export async function'], ' ', ['func', 'tides'], '(day) {'],
    ['  ', ['comment', '// Keep the forecast for 5 min.']],
    ['  ', ['keyword', 'const'], ' cached = cache.', ['func', 'get'], '(day);'],
    ['  ', ['keyword', 'if'], ' (cached) ', ['keyword', 'return'], ' cached;'],
    [],
    ['  ', ['keyword', 'const'], ' data = ', ['keyword', 'await'], ' ', ['func', 'fetchTides'], '(day);'],
    ['  cache.', ['func', 'set'], '(day, data, ', ['number', '300_000'], ');'],
    ['  ', ['keyword', 'return'], ' data;'],
    ['}'],
  ] },
  { file: 'words.py', language: 'Python', lines: [
    [['keyword', 'from'], ' collections ', ['keyword', 'import'], ' ', ['type', 'Counter']],
    [],
    ['text = ', ['string', '"wind over water over sand"']],
    ['words = ', ['type', 'Counter'], '(text.', ['func', 'split'], '())'],
    [['func', 'print'], '(words.', ['func', 'most_common'], '(', ['number', '1'], '))'],
  ] },
  { file: 'temperature.rs', language: 'Rust', lines: [
    [['keyword', 'fn'], ' ', ['func', 'celsius'], '(raw: &', ['type', 'str'], ') -> ', ['type', 'Option'], '<', ['type', 'f32'], '> {'],
    ['    ', ['keyword', 'let'], ' f: ', ['type', 'f32'], ' = raw.', ['func', 'parse'], '().', ['func', 'ok'], '()?;'],
    ['    ', ['keyword', 'let'], ' offset = f - ', ['number', '32.0'], ';'],
    ['    ', ['type', 'Some'], '(offset * ', ['number', '5.0'], ' / ', ['number', '9.0'], ')'],
    ['}'],
  ] },
  { file: 'health.go', language: 'Go', lines: [
    [['keyword', 'package'], ' health'],
    [],
    [['keyword', 'import'], ' ', ['string', '"net/http"']],
    [],
    [['keyword', 'func'], ' ', ['func', 'check'], '(w http.', ['type', 'ResponseWriter'], ', _ *http.', ['type', 'Request'], ') {'],
    ['    w.', ['func', 'WriteHeader'], '(http.', ['constant', 'StatusNoContent'], ')'],
    ['}'],
  ] },
  { file: 'options.lua', language: 'Lua', lines: [
    [['comment', '-- Keep context while scrolling.']],
    ['vim.opt.', ['field', 'scrolloff'], ' = ', ['number', '6']],
    ['vim.opt.', ['field', 'number'], ' = ', ['constant', 'true']],
    ['vim.cmd.', ['func', 'colorscheme'], '(', ['string', '"karazuri"'], ')'],
  ] },
  { file: 'routes.sql', language: 'SQL', lines: [
    [['keyword', 'SELECT'], ' route, ', ['func', 'COUNT'], '(*) ', ['keyword', 'AS'], ' trips'],
    [['keyword', 'FROM'], ' ferry_log'],
    [['keyword', 'GROUP BY'], ' route'],
    [['keyword', 'ORDER BY'], ' trips ', ['keyword', 'DESC']],
    [['keyword', 'LIMIT'], ' ', ['number', '3'], ';'],
  ] },
];

const agentExamples = [
  { name: 'T3 Code', slug: 't3-code', removed: ['diff_delete', 't3-text'], added: ['diff_add', 't3-text'] },
  { name: 'OpenCode', slug: 'opencode', removed: ['oc-diffRemovedBg', 'oc-diffRemoved'], added: ['oc-diffAddedBg', 'oc-diffAdded'] },
];
---
{scene === 'editor' && <section class="preview-pane editor-pane" data-pane="editor" aria-label="Editor">
  <div class="pane-heading">
    <code class="editor-file">{samples[0].file}</code>
    <span class="static-label">{samples[0].language}</span>
    <select class="pane-select" data-interactive aria-label="Editor language">
      {samples.map(sample => <option value={sample.file}>{sample.language}</option>)}
    </select>
  </div>
  {samples.map((sample, index) => <div class="editor-code" data-sample={sample.file} aria-label={`${sample.language} code example`} hidden={index !== 0}>
    {sample.lines.map((line, i) => <div class:list={['editor-line', { 'cursor-line': sample.cursorLine === i + 1 }]}>
      <span class="line-number" aria-hidden="true">{i + 1}</span><code>{line.map(run => typeof run === 'string' ? run : <button type="button" data-role={run[0]} style={`--token: var(--${run[0]})`} disabled>{run[1]}</button>)}</code>
    </div>)}
  </div>)}
</section>}

{scene === 'agent' && <section class="preview-pane agent-pane" data-pane="agent" data-agent="t3-code" aria-label="Agent diff">
  <div class="pane-heading">
    <span>Agent diff</span>
    <span class="static-label">T3 Code</span>
    <select class="pane-select" data-interactive aria-label="Coding agent">
      {agentExamples.map(agent => <option value={agent.slug}>{agent.name}</option>)}
    </select>
  </div>
  <div class="agent-content">
    <p>Cache the tide forecast for five minutes.</p>
    {agentExamples.map((agent, index) => <div class="agent-diff" data-agent-diff={agent.slug} aria-label="Changes to tides.ts" hidden={index !== 0}>
      <button type="button" data-role={agent.removed[0]} data-role-name="Removed line" data-foreground={agent.removed[1]} style={`--token:var(--${agent.removed[1]});--diff:var(--${agent.removed[0]})`} disabled>− cache.set(day, data);</button>
      <button type="button" data-role={agent.added[0]} data-role-name="Added line" data-foreground={agent.added[1]} style={`--token:var(--${agent.added[1]});--diff:var(--${agent.added[0]})`} data-inspect-default disabled>+ cache.set(day, data, 300_000);</button>
    </div>)}
  </div>
</section>}

{scene === 'terminal' && <section class="preview-pane terminal-pane" data-pane="terminal" aria-label="Terminal output">
  <div class="pane-heading"><span>Terminal</span><code>tides.test.ts</code></div>
  <div class="terminal-content">
    <code><button class="terminal-prompt" type="button" data-role="ansi_blue" data-role-name="Terminal blue" disabled>$</button> npm test -- tides</code>
    <ul>
      <li><button type="button" data-role="ansi_green" data-role-name="Terminal green" aria-label="Inspect passed test color" data-inspect-default disabled>✓</button> fetches today’s forecast</li>
      <li><span aria-hidden="true">✓</span> reuses cached tides</li>
      <li><span aria-hidden="true">✓</span> expires after five minutes</li>
    </ul>
  </div>
</section>}
