          <figcaption><code>tides.ts</code> <span>Cache the day’s tide times</span></figcaption>
          <pre is:raw><code><span class="keyword">export async function</span> <span class="function">getTides</span>(day: <span class="type">string</span>) {
  <span class="comment">// Reuse a recent forecast.</span>
  <span class="keyword">const</span> cached = cache.<span class="function">get</span>(day);
  <span class="keyword">if</span> (cached) <span class="keyword">return</span> cached;

  <span class="keyword">const</span> tides = <span class="keyword">await</span> <span class="function">readTides</span>(day);
  cache.<span class="function">set</span>(day, tides, { <span class="field">ttl</span>: <span class="number">300_000</span> });
  <span class="keyword">return</span> tides;
}</code></pre>
