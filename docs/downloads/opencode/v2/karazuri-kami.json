{
  "$schema": "https://opencode.ai/theme.json",
  "base": {
    "categorical": [
      "accent",
      "interactive",
      "green",
      "yellow",
      "red",
      "cyan"
    ],
    "text": {
      "base": "#292830",
      "muted": "#3F3E49",
      "faint": "#4B4943",
      "action": {
        "primary": {
          "base": "#D2CCBC"
        },
        "secondary": {
          "base": "#292830"
        },
        "destructive": {
          "base": "#D2CCBC"
        }
      },
      "formfield": {
        "base": "#292830"
      },
      "feedback": {
        "error": {
          "base": "#981F2E"
        },
        "warning": {
          "base": "#82450B"
        },
        "success": {
          "base": "#36561D"
        },
        "info": {
          "base": "#20547A"
        }
      }
    },
    "background": {
      "base": "#D2CCBC",
      "raised": {
        "base": "#CEC8B8",
        "high": "#CAC3B1",
        "max": "#C2BBA8"
      },
      "action": {
        "primary": {
          "base": "#2B497A",
          "$hovered": "#3F5982"
        },
        "secondary": {
          "base": "#CAC3B1",
          "$hovered": "#B7B0A2"
        },
        "destructive": {
          "base": "#981F2E",
          "$hovered": "#9F343F"
        }
      },
      "formfield": {
        "base": "#C8C2B0",
        "$focused": "#CDC7B6"
      },
      "feedback": {
        "error": {
          "base": "#CCBBAE"
        },
        "warning": {
          "base": "#CABEAA"
        },
        "success": {
          "base": "#C2C0AC"
        },
        "info": {
          "base": "#C0C0B5"
        }
      }
    },
    "border": {
      "base": "#989280"
    },
    "scrollbar": {
      "base": "#4B4943"
    },
    "diff": {
      "text": {
        "added": "#292830",
        "removed": "#292830",
        "context": "#3F3E49",
        "hunkHeader": "#20547A"
      },
      "background": {
        "added": "#BFC9AD",
        "removed": "#D5BAB8",
        "context": "#CEC8B8"
      },
      "highlight": {
        "added": "#36561D",
        "removed": "#981F2E"
      },
      "lineNumber": {
        "text": "#3F3E49",
        "background": {
          "added": "#BFC9AD",
          "removed": "#D5BAB8"
        }
      }
    },
    "syntax": {
      "comment": "#4B4943",
      "keyword": "#523B83",
      "function": "#2B497A",
      "variable": "#292830",
      "string": "#36561D",
      "number": "#7F3451",
      "type": "#22564D",
      "operator": "#604E22",
      "punctuation": "#485064"
    },
    "markdown": {
      "text": "#292830",
      "heading": "#523B83",
      "link": "#2B497A",
      "linkText": "#22564D",
      "code": "#36561D",
      "blockQuote": "#3F3E49",
      "emphasis": "#674B0F",
      "strong": "#7B4116",
      "horizontalRule": "#989280",
      "listItem": "#2B497A",
      "listEnumeration": "#7F3451",
      "image": "#2B497A",
      "imageText": "#22564D",
      "codeBlock": "#292830"
    }
  },
  "light": {
